export function formatCLP(value: number) {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(value)
}

export function getFriendlyServiceName(value: string | null | undefined) {
  const text = String(value ?? '').trim().toLowerCase()
  if (!text) return 'Servicio'
  if (text.includes('diagn') || text.includes('elect')) return 'Diagnóstico eléctrico'
  if (text.includes('repar')) return 'Reparaciones eléctricas'
  if (text.includes('instal')) return 'Instalaciones eléctricas'
  if (text.includes('cert')) return 'Certificación SEC'
  if (text.includes('mant')) return 'Mantenimiento preventivo'
  if (text.includes('industrial')) return 'Mantenimiento industrial'
  if (text.includes('tablero')) return 'Tableros eléctricos'
  if (text.includes('ilumin')) return 'Iluminación LED'
  if (text.includes('automat')) return 'Automatización'
  return 'Servicio'
}

export const statusOrder = ['pendiente', 'en camino', 'en proceso', 'finalizado', 'rechazado'] as const

export type ServiceStatus = (typeof statusOrder)[number]

export function normalizeServiceValue(value: unknown) {
  return String(value ?? '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[^\w\s]/g, '')
    .replace(/\s+/g, '-')
}
